{
  "ai": {
    "provider": "gemini",
    "model": "gemini-2.5-flash",
    "api_key_env": "GOOGLE_API_KEY",
    "languages": ["pt"],
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 4.5,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1
  },
  "collection": {
    "time_window_hours": 24
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tdah-familia",
    "profile_settings": {
      "tdah-ciencia": {
        "threshold": 6.0,
        "topic_dedup": true
      },
      "tdah-familia": {
        "threshold": 6.0,
        "topic_dedup": true
      }
    }
  },
  "digest": {
    "max_items": 15,
    "profile_order": ["tdah-familia", "tdah-ciencia"]
  },
  "display": {
    "icon_style": "emoji"
  },
  "sources": {
    "hackernews": {
      "enabled": false
    },
    "google_news": {
      "enabled": true,
      "query": "TDAH OR \"déficit de atenção\" OR \"hiperatividade infantil\"",
      "language": "pt-BR",
      "country": "BR",
      "ceid": "BR:pt-419",
      "max_results": 60,
      "category": "noticias-brasil",
      "profile": ["tdah-familia", "tdah-ciencia"]
    },
    "rss": [
      {
        "name": "ScienceDaily: TDAH (mente e cérebro)",
        "url": "https://www.sciencedaily.com/rss/mind_brain/add_and_adhd.xml",
        "enabled": true,
        "category": "pesquisa",
        "profile": "tdah-ciencia"
      },
      {
        "name": "ScienceDaily: TDAH (saúde)",
        "url": "https://sciencedaily.com/rss/health_medicine/add_and_adhd.xml",
        "enabled": true,
        "category": "pesquisa",
        "profile": "tdah-ciencia"
      },
      {
        "name": "Medical News Today: TDAH",
        "url": "https://rss.medicalnewstoday.com/adhd.xml",
        "enabled": true,
        "category": "pesquisa",
        "profile": ["tdah-ciencia", "tdah-familia"]
      },
      {
        "name": "ADDitude Magazine",
        "url": "https://www.additudemag.com/category/blog/feed/",
        "enabled": true,
        "category": "familia",
        "profile": ["tdah-familia", "tdah-ciencia"]
      }
    ],
    "reddit": {
      "enabled": true,
      "fetch_comments": 5,
      "subreddits": [
        {
          "subreddit": "ADHDparenting",
          "enabled": true,
          "sort": "top",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 20,
          "category": "conversa-entre-pais",
          "profile": "tdah-familia"
        }
      ],
      "users": []
    },
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "github": []
  }
}
